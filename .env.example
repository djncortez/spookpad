# ===== Web (public: these end up in the browser) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase "anon" / publishable key (safe in the browser: RLS and the locked tables protect the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Helius free key. Lock it to your site's domain in the Helius dashboard (it is visible in the browser).
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Admin page =====
# The admin page lives at /<ADMIN_SLUG>/ (8-64 letters, digits, - or _). Pick something unguessable.
ADMIN_SLUG=

# ===== Supabase function secrets =====
# Not read from this file. Set them on Supabase with: npx supabase secrets set NAME=value
#   HELIUS_API_KEY          Helius key for the server (a different key from the browser one is best)
#   SITE_ORIGINS            http://localhost:3000,https://YOUR-SITE.netlify.app
#   SITE_URL                https://YOUR-SITE.netlify.app   (the website in every coin's metadata)
#   TREASURY_ADDRESS        the wallet that receives costume and launch fees (a separate wallet you control)
#   OPENROUTER_API_KEY      from openrouter.ai/settings/keys (top up credits with USDC at openrouter.ai/settings/credits)
#   OPENROUTER_MODEL        optional; default google/gemini-nano-banana-2.1
#   ADMIN_WALLET            your Phantom address (public)
#   ADMIN_SESSION_SECRET    node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   PINATA_JWT              optional IPFS fallback
#   TELEGRAM_BOT_TOKEN, ADMIN_TELEGRAM_CHAT_ID   optional: a Telegram DM when OpenRouter credit runs low
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions by Supabase automatically.
